# Azure AD app registration (app-only / client_credentials)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me

# SharePoint tenant — root site URL, no trailing slash
SHAREPOINT_TENANT=https://contoso.sharepoint.com
# Site that hosts SPAlerts_Definitions (server-relative path or absolute URL)
DEFINITIONS_SITE_URL=https://contoso.sharepoint.com/sites/AlertsDemo
DEFINITIONS_LIST_TITLE=SPAlerts_Definitions

# Mailbox used as the sender for outbound alert emails (Graph sendMail)
SENDER_EMAIL=alerts@contoso.com

# Public HTTPS URL of this App Service — SharePoint will POST notifications here
WEBHOOK_NOTIFICATION_URL=https://your-app.azurewebsites.net/webhook

PORT=8080
